# Copie para `.env` (que é ignorado pelo git) e preencha. NUNCA commite o .env.
# No GitHub Actions, estes valores vêm de Settings > Secrets and variables > Actions.

# Token do bot (BotFather) e id do chat que receberá os alertas.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Força UTF-8 no console do Windows (evita acentos quebrados nos logs).
PYTHONUTF8=1
